-- ============================================================
-- TRIGGERS (SQLite syntax)
-- ============================================================

-- ลดสต๊อกอัตโนมัติเมื่อมี order_items ใหม่
CREATE TRIGGER IF NOT EXISTS trg_reduce_stock
AFTER INSERT ON order_items
BEGIN
    UPDATE stock
    SET quantity = quantity - NEW.quantity,
        updated_at = datetime('now','localtime')
    WHERE product_id = NEW.product_id;

    INSERT INTO stock_logs (product_id, change_qty, reason, ref_order_id)
    VALUES (NEW.product_id, -NEW.quantity, 'ขายออก', NEW.order_id);
END;

-- ============================================================
-- VIEWS
-- ============================================================

-- สินค้าพร้อมสต๊อก
CREATE VIEW IF NOT EXISTS v_product_stock AS
SELECT
    p.product_id,
    p.product_name,
    p.price,
    p.category,
    s.quantity     AS stock_qty,
    s.min_quantity,
    CASE WHEN s.quantity <= s.min_quantity THEN 'ต่ำ ⚠️' ELSE 'ปกติ ✅' END AS stock_status
FROM products p
JOIN stock s ON p.product_id = s.product_id
WHERE p.is_active = 1;

-- สถิติยอดขายต่อสินค้า
CREATE VIEW IF NOT EXISTS v_sales_summary AS
SELECT
    p.product_name,
    p.category,
    SUM(oi.quantity)           AS total_sold,
    SUM(oi.subtotal)           AS total_revenue,
    COUNT(DISTINCT oi.order_id) AS order_count
FROM order_items oi
JOIN products p ON oi.product_id = p.product_id
JOIN orders o   ON oi.order_id   = o.order_id
WHERE o.status != 'cancelled'
GROUP BY p.product_id, p.product_name, p.category
ORDER BY total_revenue DESC;

-- ประวัติออเดอร์พร้อมชื่อลูกค้า
CREATE VIEW IF NOT EXISTS v_order_history AS
SELECT
    o.order_id,
    c.full_name      AS customer_name,
    c.phone,
    o.total_amount,
    o.status,
    o.payment_method,
    o.order_date
FROM orders o
JOIN customers c ON o.customer_id = c.customer_id
ORDER BY o.order_date DESC;

