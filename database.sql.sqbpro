DROP TABLE IF EXISTS stock_logs;
DROP TABLE IF EXISTS transactions;
DROP TABLE IF EXISTS order_items;
DROP TABLE IF EXISTS orders;
DROP TABLE IF EXISTS stock;
DROP TABLE IF EXISTS products;
DROP TABLE IF EXISTS customers;

DROP VIEW IF EXISTS v_product_stock;
DROP VIEW IF EXISTS v_sales_summary;
DROP VIEW IF EXISTS v_order_history;
-- ============================================================
--  BU SHOP DATABASE - Final Project: Database
--  กรุงเทพมหาวิทยาลัย | SQLite Version (DB Browser)
-- ============================================================

-- ============================================================
-- 1. ตาราง customers
-- ============================================================
CREATE TABLE IF NOT EXISTS customers (
    customer_id  INTEGER PRIMARY KEY AUTOINCREMENT,
    full_name    TEXT    NOT NULL,
    email        TEXT    NOT NULL UNIQUE,
    phone        TEXT,
    address      TEXT,
    city         TEXT,
    province     TEXT,
    postal_code  TEXT,
    created_at   TEXT    DEFAULT (datetime('now','localtime')),
    updated_at   TEXT    DEFAULT (datetime('now','localtime'))
);

-- ============================================================
-- 2. ตาราง products
-- ============================================================
CREATE TABLE IF NOT EXISTS products (
    product_id   INTEGER PRIMARY KEY AUTOINCREMENT,
    product_name TEXT    NOT NULL,
    description  TEXT,
    price        REAL    NOT NULL,
    category     TEXT,
    image_url    TEXT,
    is_active    INTEGER DEFAULT 1,
    created_at   TEXT    DEFAULT (datetime('now','localtime'))
);

-- ============================================================
-- 3. ตาราง stock
-- ============================================================
CREATE TABLE IF NOT EXISTS stock (
    stock_id     INTEGER PRIMARY KEY AUTOINCREMENT,
    product_id   INTEGER NOT NULL,
    quantity     INTEGER NOT NULL DEFAULT 0,
    min_quantity INTEGER DEFAULT 5,
    updated_at   TEXT    DEFAULT (datetime('now','localtime')),
    FOREIGN KEY (product_id) REFERENCES products(product_id)
);

-- ============================================================
-- 4. ตาราง orders
-- ============================================================
CREATE TABLE IF NOT EXISTS orders (
    order_id       INTEGER PRIMARY KEY AUTOINCREMENT,
    customer_id    INTEGER NOT NULL,
    total_amount   REAL    NOT NULL,
    status         TEXT    DEFAULT 'pending',
    payment_method TEXT    DEFAULT 'โอนเงิน',
    note           TEXT,
    order_date     TEXT    DEFAULT (datetime('now','localtime')),
    updated_at     TEXT    DEFAULT (datetime('now','localtime')),
    FOREIGN KEY (customer_id) REFERENCES customers(customer_id)
);

-- ============================================================
-- 5. ตาราง order_items
-- ============================================================
CREATE TABLE IF NOT EXISTS order_items (
    item_id    INTEGER PRIMARY KEY AUTOINCREMENT,
    order_id   INTEGER NOT NULL,
    product_id INTEGER NOT NULL,
    quantity   INTEGER NOT NULL,
    unit_price REAL    NOT NULL,
    subtotal   REAL    NOT NULL,   -- เก็บค่าตรงๆ แทน GENERATED COLUMN
    FOREIGN KEY (order_id)   REFERENCES orders(order_id),
    FOREIGN KEY (product_id) REFERENCES products(product_id)
);

-- ============================================================
-- 6. ตาราง transactions
-- ============================================================
CREATE TABLE IF NOT EXISTS transactions (
    transaction_id INTEGER PRIMARY KEY AUTOINCREMENT,
    order_id       INTEGER NOT NULL,
    amount         REAL    NOT NULL,
    payment_method TEXT,
    status         TEXT    DEFAULT 'pending',
    slip_url       TEXT,
    transaction_at TEXT    DEFAULT (datetime('now','localtime')),
    FOREIGN KEY (order_id) REFERENCES orders(order_id)
);

-- ============================================================
-- 7. ตาราง stock_logs
-- ============================================================
CREATE TABLE IF NOT EXISTS stock_logs (
    log_id       INTEGER PRIMARY KEY AUTOINCREMENT,
    product_id   INTEGER NOT NULL,
    change_qty   INTEGER NOT NULL,
    reason       TEXT,
    ref_order_id INTEGER,
    logged_at    TEXT    DEFAULT (datetime('now','localtime')),
    FOREIGN KEY (product_id)   REFERENCES products(product_id),
    FOREIGN KEY (ref_order_id) REFERENCES orders(order_id)
);

